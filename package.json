{
  "name": "airport-for-all",
  "version": "1.0.0",
  "private": true,
  "description": "An immersive, data-driven reading of article.md \u2014 what happens to Canada if its airports are privatized.",
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start -p 4310",
    "typecheck": "tsc --noEmit",
    "verify:sources": "node --experimental-strip-types scripts/verify-sources.ts",
    "verify:locales": "node scripts/verify-locales.mjs",
    "verify": "npm run verify:sources && npm run verify:locales"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
